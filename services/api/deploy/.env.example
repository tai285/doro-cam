# Copy to .env next to docker-compose.yml and fill in every value. Never commit the real file.
POSTGRES_PASSWORD=change-me
# openssl rand -base64 48
AUTH_SECRET=
PUBLIC_BASE_URL=https://api.example.com
WEB_ORIGINS=https://app.example.com
# Garage key ids start with GK followed by 24 hex chars; the secret is 64 hex chars.
S3_PUBLIC_ENDPOINT=https://storage.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional: sign in with Google / Apple (leave empty to keep them off)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
