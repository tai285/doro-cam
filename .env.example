# Copy to .env for local development. Values below match infrastructure/docker-compose.yml.
# These are public dev-only credentials. Never reuse them anywhere real.
DATABASE_URL=postgres://doro:doro_dev_password@127.0.0.1:5432/doro
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=garage
S3_BUCKET=doro-media
S3_ACCESS_KEY_ID=GK0123456789abcdef01234567
S3_SECRET_ACCESS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Comma-separated origins allowed to call storage directly from a browser (CORS).
S3_CORS_ORIGINS=http://localhost:5173

# --- API (all optional in development) -------------------------------------------------------
# Required in production: at least 32 random characters.
# AUTH_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated web origins allowed by CORS and used for cookies/redirects.
WEB_ORIGINS=http://localhost:5173
# Per-user storage quota in bytes (default 10 GiB).
# STORAGE_QUOTA_BYTES=10737418240
# Sign-in attempts per IP per minute.
# AUTH_RATE_LIMIT_PER_MINUTE=30
# fatal|error|warn|info|debug|trace|silent
LOG_LEVEL=info
# Optional social sign-in: set BOTH values of a pair to enable that provider (AUTH-002, AUTH-003).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_APP_BUNDLE_IDENTIFIER=
# Address clients use for storage when it differs from S3_ENDPOINT (for example behind Docker).
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# Web dashboard (apps/web): where the API lives.
# VITE_API_URL=http://localhost:3000
