{
  "name": "@doro/docs-check",
  "private": true,
  "type": "module",
  "description": "Documentation integrity checker: links, anchors, requirement IDs, ADRs, task graph, index reachability.",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check:docs": "node src/cli.ts ../..",
    "check:traceability": "node src/traceability-cli.ts ../.."
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
